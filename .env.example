# Copy to .env.local and fill in. NEVER commit .env.local.
# Public Firebase web config: Firebase console > Settings > General > Your apps (no quotes, no commas)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=trackrecord-5c3ca
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_USE_EMULATORS=true

# Server secrets: run  node scripts/generate-keys.mjs | Add-Content .env.local -Encoding ascii
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
FILE_ENCRYPTION_KEY=
TOTP_MASTER_SECRET=
CRON_SECRET=

# Firebase console > Settings > Service accounts > Generate new private key, base64-encoded
FIREBASE_SERVICE_ACCOUNT=

# Email (Phase 4, optional): free key from resend.com > API Keys. Empty = emails are only logged.
RESEND_API_KEY=
# Optional. The default test sender only reaches your own Resend account email.
# RESEND_FROM=TrackRecord <noreply@your-verified-domain>

# Optional. Minutes an athlete has to answer a proposed removal (default 4320 = 72 hours).
# Set e.g. 5 ONLY for a recorded demo; the app then shows "Demo mode" on screen.
# REMOVAL_RESPONSE_MINUTES=4320

# Optional. 12+ characters. Opens /judges for the demo accounts made by scripts/judge-accounts.mjs.
# Leave unset to keep that door closed. Remove after judging.
# JUDGE_ACCESS_CODE=
